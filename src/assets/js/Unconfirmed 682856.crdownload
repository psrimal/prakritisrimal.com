6,556:751,612:762,682:769,688:765,585:743,554:724,556:715,575:707;-145:665,-147:658,-136:651,-187:635,-228:640,-218:644,-240:649,-222:651,-243:656,-236:663,-221:664,-206:657,-191:663,-145:665;-1082:762,-1059:760,-1057:755,-1063:750,-1137:744,-1139:747,-1118:752,-1163:750,-1177:752,-1154:765,-1091:755,-1105:764,-1096:768,-1082:762;1730:-409,1742:-414,1727:-434,1731:-438,1714:-442,1706:-459,1684:-466,1667:-462,1670:-451,1705:-430,1721:-410,1728:-405,1730:-409;1058:-58,1047:-59,1026:-42,986:18,954:50,953:55,975:52,1006:21,1017:21,1038:1,1034:-7,1061:-31,1058:-58;1439:442,1453:444,1455:433,1441:430,1432:420,1416:427,1411:416,1400:416,1398:426,1403:433,1414:434,1420:456,1439:442;-870:797,-858:793,-908:782,-940:788,-932:794,-961:797,-967:802,-943:810,-947:812,-924:813,-878:803,-870:797;-678:-538,-650:-547,-655:-552,-670:-549,-682:-556,-723:-545,-747:-528,-711:-541,-694:-525,-686:-526,-678:-538;-726:199,-700:196,-683:186,-687:182,-710:183,-714:176,-724:182,-745:183,-723:187,-734:196,-726:199;-797:228,-742:203,-778:199,-771:204,-793:216,-818:222,-822:224,-818:226,-850:219,-823:232,-797:228;-684:-710,-688:-722,-711:-725,-750:-721,-750:-717,-739:-713,-721:-712,-717:-695,-702:-689,-684:-710;1454:-408,1483:-409,1484:-421,1479:-432,1476:-429,1469:-436,1460:-436,1447:-412,1447:-407,1454:-408;1520:-55,1497:-63,1483:-58,1498:-55,1500:-50,1508:-55,1516:-48,1515:-42,1521:-42,1520:-55;1255:122,1258:110,1250:113,1253:104,1248:101,1245:109,1243:115,1249:118,1243:126,1255:122;-852:657,-801:637,-826:636,-831:641,-855:630,-859:636,-872:635,-864:640,-859:657,-852:657;-1004:738,-971:735,-980:730,-965:726,-967:717,-984:713,-1025:725,-1004:727,-1015:734,-1004:738;-1205:714,-1231:709,-1259:719,-1239:737,-1249:743,-1215:744,-1176:742,-1155:735,-1192:725,-1205:714;182:797,215:790,190:786,171:768,138:774,147:777,132:780,104:796,170:800,182:797;1086:-68,1105:-69,1108:-65,1157:-84,1146:-88,1106:-81,1054:-68,1060:-59,1086:-68;1287:11,1286:3,1281:4,1280:-2,1284:-8,1277:-3,1276:18,1279:22,1287:11;1240:103,1230:90,1224:97,1228:103,1230:109,1235:109,1233:103,1241:112,1240:103;-452:-780,-439:-785,-433:-800,-505:-810,-542:-806,-510:-796,-487:-780,-452:-780;-985:767,-977:763,-982:750,-1009:751,-1009:756,-1025:756,-1026:763,-985:767;-1001:783,-997:779,-1013:780,-1052:784,-1042:787,-1055:793,-1035:792,-1001:783';
const GEO = {
  world: WORLD_110.split(';').map((ring) => ring.split(',').map((pt) => {
    const i = pt.indexOf(':'); return [+pt.slice(0, i) / 10, +pt.slice(i + 1) / 10];
  })),
  world50: null,
  city: {}
};
const REDRAWS = [];
let GEO_GEN = 0;   // bumped whenever new geography finishes loading
const redrawAll = () => REDRAWS.forEach((f) => { try { f(); } catch (e) { /* keep going */ } });
const grab = (u) => fetch(u).then((r) => (r.ok ? r.json() : null)).catch(() => null);

grab('/assets/data/world-50m.json').then((w) => { if (w) { GEO.world50 = w.rings; GEO_GEN++; redrawAll(); } });

/* city files are decoded once into [lon, lat] rings per layer */
function decodeCity(doc) {
  const [ox, oy] = doc.origin, u = doc.unit, layers = {};
  let n = 0;
  for (const k in doc.layers) {
    layers[k] = doc.layers[k].map((r) => {
      let x = r[0], y = r[1];
      const out = [[ox + x * u, oy + y * u]];
      for (let i = 2; i < r.length; i += 2) { x += r[i]; y += r[i + 1]; out.push([ox + x * u, oy + y * u]); }
      n += out.length;
      return out;
    });
  }
  return { layers, points: n, source: doc.source, bbox: doc.bbox };
}
TOUR.forEach((c) => {
  grab(`/assets/data/city-${c.id}.json`).then((d) => { if (d) { GEO.city[c.id] = decodeCity(d); GEO_GEN++; redrawAll(); } });
});

/* ---------------- markers ---------------- */
const MARKERS = [
  { n: 'BENGALURU', lat: 12.97, lon: 77.59, tier: 'study', c: C.active, grain: 135.6 },
  { n: 'LONDON', lat: 51.51, lon: -0.13, tier: 'research', c: C.network },
  { n: 'DELHI', lat: 28.61, lon: 77.21, tier: 'comparison', c: C.form, grain: 74.2 },
  { n: 'MUMBAI', lat: 19.08, lon: 72.88, tier: 'comparison', c: C.form, grain: 57.9 },
  { n: 'KOLKATA', lat: 22.57, lon: 88.36, tier: 'comparison', c: C.form, grain: 81.8 },
  { n: 'CHENNAI', lat: 13.08, lon: 80.27, tier: 'comparison', c: C.form, grain: 90.4 },
  { n: 'SINGAPORE', lat: 1.35, lon: 103.82, tier: 'next', c: C.water },
  { n: 'DUBAI', lat: 25.20, lon: 55.27, tier: 'writing', c: C.sensing }
];
const PRIO = { study: 0, research: 1, comparison: 2, next: 3, writing: 4 };

function drawMarker(ctx, m, x, y, t) {
  if (m.tier === 'study') {
    ctx.beginPath(); ctx.arc(x, y, 3.6, 0, 7); ctx.fillStyle = m.c; ctx.fill();
    ctx.beginPath(); ctx.arc(x, y, 9 + Math.sin(t * 0.03) * 2.2, 0, 7);
    ctx.strokeStyle = 'rgba(166,248,196,.5)'; ctx.lineWidth = 1; ctx.stroke();
  } else if (m.tier === 'comparison') {
    ctx.strokeStyle = m.c; ctx.lineWidth = 1.3; ctx.beginPath(); ctx.arc(x, y, 3.2, 0, 7); ctx.stroke();
  } else if (m.tier === 'next') {
    ctx.strokeStyle = m.c; ctx.lineWidth = 1.1; ctx.setLineDash([2, 2]);
    ctx.beginPath(); ctx.arc(x, y, 3.4, 0, 7); ctx.stroke(); ctx.setLineDash([]);
  } else {
    ctx.beginPath(); ctx.arc(x, y, 3.1, 0, 7); ctx.fillStyle = m.c; ctx.fill();
  }
}

function placeLabels(ctx, labels) {
  labels.sort((a, b) => PRIO[a.m.tier] - PRIO[b.m.tier]);
  const placed = [];
  for (const L of labels) {
    const tw = ctx.measureText(L.text).width;
    let box = null;
    for (const [dx, dy] of [[15, 3.4], [15, -9], [-tw - 15, 3.4], [15, 15], [-tw - 15, -9]]) {
      const b = { x: L.x + dx, y: L.y + dy - 9, w: tw + 6, h: 13 };
      if (!placed.some((q) => !(b.x > q.x + q.w || b.x + b.w < q.x || b.y > q.y + q.h || b.y + b.h < q.y))) { box = b; break; }
    }
    if (!box) continue;
    placed.push(box);
    ctx.globalAlpha = L.fade;
    ctx.fillStyle = L.m.tier === 'study' ? 'rgba(238,241,234,.96)' : 'rgba(176,190,186,.82)';
    ctx.fillText(L.text, box.x, box.y + 9.6);
    ctx.globalAlpha = 1;
  }
}

/* ---------------- orthographic projection ----------------
   One projection for every scale. At planet scale it is a globe; zoomed in
   it is indistinguishable from a flat map around the centre, so there is no
   handoff between two drawing systems. */
function ortho(lat0, lon0, R, cx, cy) {
  const sp0 = Math.sin(lat0 * D), cp0 = Math.cos(lat0 * D), l0 = lon0 * D;
  return (lat, lon, out) => {
    const p = lat * D, dl = lon * D - l0, cp = Math.cos(p), sp = Math.sin(p), cdl = Math.cos(dl);
    out[0] = cx + R * cp * Math.sin(dl);
    out[1] = cy - R * (cp0 * sp - sp0 * cp * cdl);
    out[2] = sp0 * sp + cp0 * cp * cdl;   // > 0 means on the visible hemisphere
    return out;
  };
}

function strokeRings(ctx, rings, P, w, h, close) {
  const q = [0, 0, 0], pad = 40;
  ctx.beginPath();
  for (const ring of rings) {
    let pen = false, px = 0, py = 0;
    for (let i = 0; i < ring.length; i++) {
      P(ring[i][1], ring[i][0], q);
      if (q[2] <= 0) { pen = false; continue; }
      const off = q[0] < -pad || q[0] > w + pad || q[1] < -pad || q[1] > h + pad;
      if (off && (!pen || (px < -pad || px > w + pad || py < -pad || py > h + pad))) {
        pen = false; px = q[0]; py = q[1]; continue;
      }
      if (!pen) { ctx.moveTo(q[0], q[1]); pen = true; } else ctx.lineTo(q[0], q[1]);
      px = q[0]; py = q[1];
    }
    if (close && pen) ctx.closePath();
  }
  ctx.stroke();
}

function coast(ctx, P, w, h, rings, alpha, width) {
  ctx.save();
  ctx.lineJoin = 'round'; ctx.lineCap = 'round';
  ctx.strokeStyle = `rgba(166,248,196,${0.16 * alpha})`; ctx.lineWidth = width * 3.2;
  strokeRings(ctx, rings, P, w, h);
  ctx.strokeStyle = `rgba(216,242,230,${alpha})`; ctx.lineWidth = width;
  strokeRings(ctx, rings, P, w, h);
  ctx.restore();
}

/* ---------------- hero and closing globe ---------------- */
function globeField(canvas, opts) {
  const o = Object.assign({ count: 4000, spin: 0.00003, seed: 7, radius: 0.43, lat: 14, lon: 72 }, opts || {});
  let ctx, w, h, raf = null, t = 0, vis = true;
  const r0 = rng(o.seed), pts = [];
  for (let i = 0; i < o.count; i++) pts.push({ lat: Math.asin(2 * r0() - 1) / D, lon: r0() * 360 - 180, s: 0.5 + r0() * 0.9 });
  const size = () => { const f = fitCanvas(canvas); ctx = f.ctx; w = f.w; h = f.h; };
  const q = [0, 0, 0];

  function draw() {
    ctx.clearRect(0, 0, w, h);
    const desk = w > 900;
    const R = Math.min(w, h) * o.radius;
    const cx = w * (desk ? 0.68 : 0.5), cy = h * 0.5;
    const lon0 = o.lon - t * o.spin * 60 / D;
    const P = ortho(o.lat, lon0, R, cx, cy);

    ctx.strokeStyle = `rgba(86,116,116,${desk ? 0.46 : 0.30})`; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(cx, cy, R, 0, 7); ctx.stroke();
    const grat = [];
    for (let la = -60; la <= 60; la += 30) { const r = []; for (let lo = -180; lo <= 180; lo += 4) r.push([lo, la]); grat.push(r); }
    for (let lo = -180; lo < 180; lo += 30) { const r = []; for (let la = -88; la <= 88; la += 4) r.push([lo, la]); grat.push(r); }
    strokeRings(ctx, grat, P, w, h);

    for (const p of pts) {
      P(p.lat, p.lon, q); if (q[2] < 0) continue;
      ctx.fillStyle = `rgba(166,248,196,${Math.min(1, (0.16 + q[2] * 0.72) * (desk ? 2.2 : 1.15))})`;
      const s = p.s * (desk ? 1.45 : 1.25);
      ctx.fillRect(q[0], q[1], s, s);
    }
    coast(ctx, P, w, h, GEO.world, desk ? 0.98 : 0.78, desk ? 1.35 : 1);

    for (const m of MARKERS) {
      P(m.lat, m.lon, q); if (q[2] <= 0.02) continue;
      const fade = Math.min(1, (q[2] - 0.02) / 0.28);
      ctx.globalAlpha = fade; drawMarker(ctx, m, q[0], q[1], t); ctx.globalAlpha = 1;
    }
    /* no city names on the hero globe; the tour names them as it arrives */
  }
  const loop = () => { if (!vis) { raf = null; return; } t += 1; draw(); raf = requestAnimationFrame(loop); };
  size(); draw();
  REDRAWS.push(() => { size(); draw(); });
  if (!RM) new IntersectionObserver((es) => { vis = es[0].isIntersecting; if (vis && !raf) raf = requestAnimationFrame(loop); }, { threshold: 0.02 }).observe(canvas);
  addEventListener('resize', () => { size(); draw(); });
}
if ($('#heroCanvas')) globeField($('#heroCanvas'), { count: 5200, seed: 11 });
if ($('#closeCanvas')) globeField($('#closeCanvas'), { count: 4000, seed: 29, spin: 0.000022, radius: 0.40, lon: 60 });

/* ---------------- the tour ---------------- */
(function tour() {
  const sec = $('#tour'), cv = $('#tourCanvas');
  if (!sec || !cv) return;
  let ctx, w, h;
  const size = () => { const f = fitCanvas(cv); ctx = f.ctx; w = f.w; h = f.h; };

  /* camera keyframes: an Earth view, then one per city */
  const shortSide = () => Math.min(w, h);
  const radiusFor = (km) => shortSide() * EARTH_KM / km;
  const KEYS = () => [
    { id: 'earth', lat: 16, lon: 68, R: shortSide() * 0.40, name: 'EARTH' },
    ...TOUR.map((c) => ({ id: c.id, lat: c.lat, lon: c.lon, R: radiusFor(c.camera.km), name: c.name.toUpperCase() }))
  ];

  function slerp(a, b, t) {
    const la1 = a.lat * D, lo1 = a.lon * D, la2 = b.lat * D, lo2 = b.lon * D;
    const v1 = [Math.cos(la1) * Math.cos(lo1), Math.cos(la1) * Math.sin(lo1), Math.sin(la1)];
    const v2 = [Math.cos(la2) * Math.cos(lo2), Math.cos(la2) * Math.sin(lo2), Math.sin(la2)];
    const dot = clamp(v1[0] * v2[0] + v1[1] * v2[1] + v1[2] * v2[2], -1, 1), om = Math.acos(dot);
    if (om < 1e-6) return { lat: a.lat, lon: a.lon, ang: 0 };
    const s1 = Math.sin((1 - t) * om) / Math.sin(om), s2 = Math.sin(t * om) / Math.sin(om);
    const v = [v1[0] * s1 + v2[0] * s2, v1[1] * s1 + v2[1] * s2, v1[2] * s1 + v2[2] * s2];
    return { lat: Math.atan2(v[2], Math.hypot(v[0], v[1])) / D, lon: Math.atan2(v[1], v[0]) / D, ang: om };
  }

  /* fly from a to b: centre along the great circle, zoom out and back in on a
     log scale so both ends are visible at the top of the arc */
  function camera(f) {
    const K = KEYS(), i = clamp(Math.floor(f), 0, K.length - 2), raw = clamp(f - i, 0, 1);
    const t = sstep(0.30, 0.70, raw);    // hold at each end so a card can be read
    const a = K[i], b = K[i + 1], c = slerp(a, b, t);
    const la = Math.log(a.R), lb = Math.log(b.R);
    const top = Math.log(Math.min(a.R, b.R, shortSide() * 0.55 / Math.max(0.12, c.ang || slerp(a, b, 1).ang)));
    const peak = Math.min(la, lb, top);
    const mid = 2 * peak - (la + lb) / 2;
    const lr = (1 - t) * (1 - t) * la + 2 * t * (1 - t) * Math.min(mid, Math.max(la, lb)) + t * t * lb;
    return { lat: c.lat, lon: c.lon, R: Math.exp(lr), key: raw < 0.5 ? a : b };
  }

  function scaleText(R) {
    const mPerPx = EARTH_KM * 1000 / R;
    const n = mPerPx * 3780;             // 96 dpi, 3780 px per metre
    const mag = Math.pow(10, Math.floor(Math.log10(n)));
    const v = Math.round(n / mag) * mag;
    return '1:' + v.toLocaleString('en-GB');
  }

  const cloud = (() => { const r = rng(4242), a = []; for (let i = 0; i < 3200; i++) a.push({ lat: Math.asin(2 * r() - 1) / D, lon: r() * 360 - 180, s: 0.4 + r() * 0.8 }); return a; })();
  const q = [0, 0, 0];
  let curKey = null;

  function draw(f) {
    ctx.clearRect(0, 0, w, h);
    const desk = w > 900;
    const cam = camera(f);
    const cx = desk ? w * 0.36 : w * 0.5, cy = desk ? h * 0.5 : h * 0.36;
    const P = ortho(cam.lat, cam.lon, cam.R, cx, cy);
    const zoom = cam.R / shortSide();          // 0.4 is the whole Earth
    const planet = 1 - sstep(1.2, 4, zoom);    // dot field and graticule
    const local = sstep(8, 30, zoom);          // street networks

    if (planet > 0.02) {
      ctx.strokeStyle = `rgba(102,136,136,${0.8 * planet})`; ctx.lineWidth = 1.2;
      ctx.beginPath(); ctx.arc(cx, cy, cam.R, 0, 7); ctx.stroke();
      for (const p of cloud) {
        P(p.lat, p.lon, q); if (q[2] < 0) continue;
        ctx.fillStyle = `rgba(166,248,196,${Math.min(1, (0.30 + q[2] * 0.70) * planet * (desk ? 2.1 : 1.4))})`;
        ctx.fillRect(q[0], q[1], p.s * 1.2, p.s * 1.2);
      }
    }

    /* coastline: coarse at planet scale, finer as soon as it would show */
    const rings = zoom > 1.1 && GEO.world50 ? GEO.world50 : GEO.world;
    coast(ctx, P, w, h, rings, 1 - local * 0.55, desk ? 1.4 : 1.1);

    /* street networks, for whichever city files exist */
    if (local > 0.01) {
      for (const id in GEO.city) {
        const L = GEO.city[id].layers;
        ctx.save(); ctx.lineJoin = 'round'; ctx.lineCap = 'round';
        if (L.water) { ctx.strokeStyle = `rgba(115,207,229,${0.75 * local})`; ctx.lineWidth = 1; ctx.fillStyle = `rgba(115,207,229,${0.10 * local})`; strokeRings(ctx, L.water, P, w, h, true); }
        /* streets outside the district: same colours, drawn first, at 20% so
           the boundary reads without a hard cut at the edge */
        const OUT = 0.20;
        if (L.local_out) { ctx.strokeStyle = `rgba(120,160,155,${0.30 * local * OUT})`; ctx.lineWidth = 0.5; strokeRings(ctx, L.local_out, P, w, h); }
        if (L.minor_out) { ctx.strokeStyle = `rgba(150,190,182,${0.55 * local * OUT})`; ctx.lineWidth = 0.7; strokeRings(ctx, L.minor_out, P, w, h); }
        if (L.major_out) { ctx.strokeStyle = `rgba(214,240,228,${0.85 * local * OUT})`; ctx.lineWidth = 1.2; strokeRings(ctx, L.major_out, P, w, h); }
        /* inside the district, full strength */
        if (L.local) { ctx.strokeStyle = `rgba(120,160,155,${0.30 * local})`; ctx.lineWidth = 0.5; strokeRings(ctx, L.local, P, w, h); }
        if (L.minor) { ctx.strokeStyle = `rgba(150,190,182,${0.55 * local})`; ctx.lineWidth = 0.7; strokeRings(ctx, L.minor, P, w, h); }
        if (L.major) { ctx.strokeStyle = `rgba(214,240,228,${0.85 * local})`; ctx.lineWidth = 1.2; strokeRings(ctx, L.major, P, w, h); }
        if (L.boundary) { ctx.setLineDash([4, 4]); ctx.strokeStyle = `rgba(166,248,196,${0.9 * local})`; ctx.lineWidth = 1.3; strokeRings(ctx, L.boundary, P, w, h, true); ctx.setLineDash([]); }
        ctx.restore();
      }
    }

    /* markers stay until the city fills the frame */
    const mA = 1 - sstep(10, 40, zoom);
    if (mA > 0.01) {
      ctx.font = '10px "Roboto Mono", ui-monospace, monospace';
      const labels = [];
      const india = cam.key.id === 'india' ? 1 - Math.abs(f - (1 + TOUR.findIndex((c) => c.id === 'india'))) : 0;
      const indiaA = sstep(0, 0.6, india);
      const blr = MARKERS[0], pb = [0, 0, 0];
      P(blr.lat, blr.lon, pb);
      for (const m of MARKERS) {
        P(m.lat, m.lon, q); if (q[2] <= 0.02) continue;
        if (q[0] < -20 || q[0] > w + 20 || q[1] < -20 || q[1] > h + 20) continue;
        if (m.tier === 'comparison' && indiaA > 0.01 && pb[2] > 0) {
          ctx.strokeStyle = `rgba(249,172,117,${0.45 * indiaA * mA})`; ctx.setLineDash([3, 4]); ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(pb[0], pb[1]); ctx.lineTo(q[0], q[1]); ctx.stroke(); ctx.setLineDash([]);
        }
        ctx.globalAlpha = mA; drawMarker(ctx, m, q[0], q[1], 0); ctx.globalAlpha = 1;
        const withGrain = m.grain && indiaA > 0.5 && w > 640;
        labels.push({ m, x: q[0], y: q[1], fade: mA, text: withGrain ? `${m.n}  ${m.grain}` : m.n });
      }
      placeLabels(ctx, labels);
    }

    /* readout, all of it computed rather than asserted */
    const k = cam.key.id;
    {
      $('#scaleName').textContent = cam.key.name;
      $('#scaleValue').textContent = scaleText(cam.R);
      const data = GEO.city[k];
      $('#scaleState').textContent = k === 'earth' ? 'NATURAL EARTH COASTLINE'
        : data ? `OSM / ${data.points.toLocaleString('en-GB')} POINTS`
        : k === 'india' ? 'NATURAL EARTH / FIVE STUDY CORES' : 'COASTLINE ONLY / CITY DATA PENDING';
      curKey = k;
    }
  }

  /* Scroll position to a continuous stop index: 0 is Earth, 1 the first city.
     Anchors are measured in document coordinates once per layout change, not
     per frame. Reading getBoundingClientRect for every stop on every scroll
     event forces a layout each time, which is what made this feel notchy. */
  /* Each stop holds its card still for part of its scroll range. Inside that
     band the camera sits on the city; between bands it flies to the next one.
     Bands are measured in document coordinates once per layout change. */
  const stops = () => $$('#tour .stop');
  let bands = [], introY = 0, target = 0, shown = 0, running = false;

  function measure() {
    const docY = (el) => el.getBoundingClientRect().top + scrollY;
    const introEl = $('#tour .tour-intro h2');
    introY = docY(introEl) + introEl.offsetHeight / 2;
    const desk = w > 900;
    bands = stops().map((el) => {
      const top = docY(el), h = el.offsetHeight;
      if (!desk) {
        /* card scrolls; hold while its top third is on screen */
        const a = top + innerHeight * 0.20, b = top + h - innerHeight * 0.55;
        return { hold: [a, Math.max(a + 1, b)] };
      }
      const pinStart = top + innerHeight * 0.5;
      const pinEnd = top + h - innerHeight * 0.5;
      const pad = Math.min((pinEnd - pinStart) * 0.5, innerHeight * 0.45);
      return { hold: [pinStart + pad * 0.15, pinEnd - pad] };
    });
  }

  function targetFrom() {
    if (!bands.length) return 0;
    const mid = scrollY + innerHeight * 0.5;
    const first = bands[0].hold[0];
    if (mid <= introY) return 0;
    if (mid < first) return (mid - introY) / (first - introY);
    for (let i = 0; i < bands.length; i++) {
      const [h0, h1] = bands[i].hold;
      if (mid <= h1) return i + 1;                       // held on this city
      const next = bands[i + 1];
      if (!next) return i + 1;
      if (mid < next.hold[0]) {                          // flying to the next
        return i + 1 + (mid - h1) / (next.hold[0] - h1);
      }
    }
    return bands.length;
  }

  /* A little damping between scroll position and camera. Without it every
     wheel notch lands as a hard step. */
  /* The hold bands pin the camera to one exact (lat, lon, zoom), so every
     frame scrolled while a card is held is visually identical to the last.
     Redoing a 180,000-point reprojection for an unchanged picture is what
     made the hold feel jerky under real geometry. Skip the paint whenever
     neither the camera position nor the loaded geography has moved. */
  /* The damping tail means `shown` changes by a tiny amount on almost every
     frame while it settles, so an exact-match cache rarely fires during the
     part of the scroll that actually feels jerky. Round to a perceptual
     tolerance instead: once the camera has moved less than a fraction of a
     pixel's worth since the last paint, repainting buys nothing. */
  let lastPaintedKey = null, lastPaintedGen = -1;

  function paint(v) {
    const cam = camera(v);
    const key = Math.round(cam.lat * 300) + ',' + Math.round(cam.lon * 300) + ',' + Math.round(Math.log(cam.R) * 400);
    if (key === lastPaintedKey && GEO_GEN === lastPaintedGen) { markActive(v); return; }
    draw(v); markActive(v);
    lastPaintedKey = key; lastPaintedGen = GEO_GEN;
  }

  function tick() {
    const d = target - shown;
    if (Math.abs(d) < 0.0004) { shown = target; paint(shown); running = false; return; }
    shown += d * (RM ? 1 : 0.18);
    paint(shown);
    requestAnimationFrame(tick);
  }
  function kick() { if (!running) { running = true; requestAnimationFrame(tick); } }

  const onScroll = () => { target = targetFrom(); kick(); };

  function markActive(f) {
    const i = clamp(Math.round(f) - 1, 0, TOUR.length - 1);   // whole numbers are the held stops
    stops().forEach((el, j) => el.classList.toggle('is-here', j === i));
    $$('.tour-dots button').forEach((b, j) => b.setAttribute('aria-current', String(j === i)));
    updateBand(i);
  }

  /* Phone-only fixed band. Hidden on desktop by CSS, so this is cheap to
     update unconditionally rather than branching on viewport width. Content
     comes straight from the same TOUR data the desktop cards render from. */
  let lastBandIndex = -1;
  function rowHTML(a, n) {
    const num = String(n).padStart(2, '0');
    const body = `<span class="row-meta"><span>${num}</span><span class="status">${esc(a.label)}</span></span><b>${esc(a.q)}</b>`;
    return `<li class="${a.status === 'live' ? '' : 'is-dim'}">${a.href ? `<a href="${a.href}">${body}</a>` : `<div>${body}</div>`}</li>`;
  }
  function updateBand(i) {
    if (i === lastBandIndex) return;
    lastBandIndex = i;
    const band = $('#tourBand'); if (!band) return;
    const c = TOUR[i]; const h = c.hero;
    band.querySelector('.tb-kicker').textContent = c.kicker;
    band.querySelector('.tb-name').textContent = c.name;
    const heroEl = band.querySelector('.tb-hero');
    heroEl.classList.toggle('is-dim', h.status !== 'live');
    heroEl.querySelector('.tb-proj').textContent = h.title.toUpperCase();
    heroEl.querySelector('.tb-status').textContent = h.label;
    heroEl.querySelector('.tb-q').textContent = h.q;
    heroEl.querySelector('.tb-desc').textContent = h.text;
    let link = heroEl.querySelector('.tb-link');
    if (h.href) {
      if (!link) { link = document.createElement('a'); link.className = 'tb-link'; heroEl.appendChild(link); }
      link.href = h.href; link.textContent = 'Open the project';
    } else if (link) link.remove();
    band.querySelector('.tb-rows').innerHTML = (c.analyses || []).map((a, n) => rowHTML(a, n + 1)).join('');
    band.scrollTop = 0;
  }

  size(); measure(); target = shown = targetFrom(); paint(shown);
  REDRAWS.push(() => { size(); measure(); target = targetFrom(); kick(); });
  addEventListener('resize', () => { size(); measure(); target = targetFrom(); shown = target; lastPaintedKey = null; paint(shown); });
  addEventListener('scroll', onScroll, { passive: true });
  /* late web fonts and images shift the page; re-measure when they land */
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { measure(); target = targetFrom(); kick(); });
  addEventListener('load', () => { measure(); target = targetFrom(); kick(); });

  /* jump links: the small stop index and the search both use this */
  window.goToStop = (id) => {
    const el = document.getElementById('stop-' + id);
    if (el) el.scrollIntoView({ behavior: RM ? 'auto' : 'smooth', block: 'center' });
  };
  $$('.tour-dots button').forEach((b) => b.addEventListener('click', () => window.goToStop(b.dataset.id)));
})();

/* ---------------- search ---------------- */
(function search() {
  const dlg = $('#cmd'), input = $('#cmdInput'), list = $('#cmdList');
  if (!dlg) return;
  const items = [];
  TOUR.forEach((c) => {
    items.push({ city: c, q: c.hero.q, title: c.hero.title, status: c.hero.status, label: c.hero.label, href: c.hero.href });
    c.analyses.forEach((a) => items.push({ city: c, q: a.q, title: '', status: a.status, label: a.label, href: a.href }));
  });
  function render(s = '') {
    const t = s.trim().toLowerCase();
    const hits = items.filter((i) => !t || (i.q + i.title + i.city.name + i.label).toLowerCase().includes(t));
    list.innerHTML = hits.length ? hits.map((i, n) => `
      <li><button data-n="${n}">
        <span><strong style="font-family:var(--mono);font-weight:600">${esc(i.q)}</strong><br>
        <span class="lbl">${esc(i.city.name.toUpperCase())} / ${esc(i.label)}</span></span>
        <span class="lbl" style="color:${i.status === 'live' ? 'var(--active)' : 'var(--text-3)'}">${i.href ? 'OPEN' : 'GO'}</span>
      </button></li>`).join('')
      : '<li><div style="padding:18px 22px;color:var(--text-2);font-size:14px">Nothing matches that.</div></li>';
    list.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
      const i = hits[+b.dataset.n]; dlg.close();
      if (i.href) location.href = i.href; else window.goToStop && window.goToStop(i.city.id);
    }));
  }
  $('#openSearch').addEventListener('click', () => { render(''); dlg.showModal(); input.value = ''; input.focus(); });
  input.addEventListener('input', () => render(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); const b = list.querySelector('button'); if (b) b.click(); }
    if (e.key === 'ArrowDown') { e.preventDefault(); const b = list.querySelector('button'); if (b) b.focus(); }
  });
  addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); $('#openSearch').click(); } });
})();

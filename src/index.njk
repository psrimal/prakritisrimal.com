<section class="descent" aria-label="Change of scale">
  <div class="descent-sticky">
    <canvas id="scaleCanvas" aria-hidden="true"></canvas>
    <div class="descent-copy">
      <h2 id="descentTitle">From the planet<br>to the street.</h2>
      <p id="descentBody">Seven cities carry work on this site. One is the subject, one is where the research was done, four are the comparison set, and one turns up in an essay about pace.</p>
    </div>
    <div class="scale-readout" aria-live="polite">
      <div>VIEW / <b id="scaleName">EARTH</b></div>
      <div>SCALE / <b id="scaleValue">1:40,000,000</b></div>
      <div>STATE / <b id="scaleState">NATURAL EARTH COASTLINE</b></div>
    </div>
  </div>
</section>

<section class="band" id="atlas">
  <div class="shell">
    <div class="band-head">
      <h2>The atlas</h2>
    </div>

    <div class="atlas">
      <div class="map-wrap" id="mapWrap">
        <canvas id="atlasCanvas" aria-hidden="true"></canvas>
        <div class="map-hud tl"><span class="dot"></span> BENGALURU / STUDY AREA <span>12.9716 N, 77.5946 E</span></div>
        <div class="map-hud bl">SCHEMATIC SPATIAL STUDY / NOT A MEASURED MAP</div>
        <div class="map-hud br">0 <span class="bar"></span> 5 km</div>
      </div>

      <div class="panel">
        <div class="panel-top"><span>LAYER CONTROL</span><span id="signalCount">LOADING</span></div>
        <div class="filters" id="filters" role="group" aria-label="Filter investigations by domain"></div>
        <div class="rows" id="rows">
          {%- for p in projects %}{% if p.stage == 'live' %}
          <button class="row" data-id="{{ p.id }}" aria-pressed="{{ 'true' if loop.first else 'false' }}" style="color:var(--{{ p.color }})">
            <span class="row-meta">
              <span>{{ p.num }} / {{ p.domain }} / {{ p.place }}</span>
              <span class="status">{{ p.maturity }}</span>
            </span>
            <h3>{{ p.question }}</h3>
            <p>{{ p.blurb }}</p>
            {%- if p.href %}<span class="open">FULL PROJECT PAGE</span>{% endif %}
          </button>
          {% endif %}{%- endfor %}
          <div class="rows-divider">NOT YET</div>
          {%- for p in projects %}{% if p.stage != 'live' %}
          <button class="row thin" data-id="{{ p.id }}" aria-pressed="false" style="color:var(--{{ p.color }})">
            <span class="row-meta"><span>{{ p.num }} / {{ p.domain }}</span><span class="status">{{ p.maturity }}</span></span>
            <h3>{{ p.question }}</h3>
          </button>
          {% endif %}{%- endfor %}
        </div>
        <div class="panel-foot"><span>SELECT A SIGNAL TO OPEN IT</span><button class="chip" id="resetAtlas" style="min-height:0;padding:4px 8px">RESET</button></div>
      </div>
    </div>
  </div>
</section>

<section class="band" id="investigation">
  <div class="shell">
    <div class="inv-head">
      <div>
        <p class="eyebrow" id="invLabel"></p>
        <h2 id="invQuestion"></h2>
      </div>
      <p class="inv-note" id="invNote"></p>
    </div>
    <div class="tabs" role="tablist" aria-label="Investigation views" id="tabs"></div>
    <div id="panels"></div>
  </div>
</section>

<section class="band" id="recognition">
  <div class="shell">
    <div class="band-head">
      <h2>Recognition</h2>
      <p>Where the work has been awarded, published or shown.</p>
    </div>
    <ol class="recog">
      {%- for r in recognition %}
      <li>
        <span class="r-year">{{ r.year }}</span>
        <span class="r-label">{{ r.label }}</span>

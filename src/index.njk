  <input id="cmdInput" type="search" placeholder="Search: access, form, sound, pace, scenario, water" autocomplete="off">
  <ul id="cmdList"></ul>
  <div class="foot">ENTER OPENS / ESC CLOSES / SEARCH COVERS THE LISTED INVESTIGATIONS ONLY</div>
</dialog>

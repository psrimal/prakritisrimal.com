<main id="top">

<section class="hero">
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <div class="shell">
    <div class="hero-grid">
      <div>
        <p class="eyebrow" id="bootLine">OBSERVE / 001</p>
        <h1 class="display">Cities are conversations.<br><span class="dim">I listen through data.</span></h1>
        <div class="hero-actions">
          <a class="btn solid" href="#atlas">Open the atlas</a>
          <a class="btn" href="#about">About Prakriti</a>
        </div>
      </div>
      <div></div>
